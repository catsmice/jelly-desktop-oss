<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine compiles code as it runs, which the hardened
       runtime forbids unless this is granted. Applied to the helpers too.
       allow-unsigned-executable-memory was dropped in 0.2.0: she runs without it. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
